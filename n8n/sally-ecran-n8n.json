    {
      "id": "e4bdedc3-17a7-5e29-a4ca-0f8c997ef226",
      "name": "Autoriser ecran",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const requete=$('Ecran Webhook').first().json;\nconst body=requete.body||{},origin=String(requete.headers?.origin||'');\nconst permis=['https://thecat78500.github.io','http://127.0.0.1:8765','http://localhost:8765'];\nconst code=typeof body.partie==='string'?body.partie.trim().toUpperCase():'';\nconst token=typeof body.cle==='string'?body.cle:'';\nconst lignes=$input.all().map(i=>i.json);\nconst session=lignes.length===1?lignes[0]:null;\nconst autorise=(!origin||permis.includes(origin))&&/^M[A-Z0-9]{7}$/.test(code)&&/^[a-f0-9]{64}$/.test(token)&&\n  session?.session_id===code&&session.ecran_token===token&&['accueil','en_cours'].includes(session.statut);\nreturn [{json:autorise?{autorise:true,session_id:code,session}:{autorise:false}}];\n"
      }
    },
    {
      "id": "d7b0aee6-9aee-515e-a450-81bcbf3cb74c",
      "name": "Acces accepte",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "8fe64ac7-08ac-495a-bbe3-88074d0c9a3e",
              "leftValue": "={{ $json.autorise === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "53055a1a-56f2-44bf-a899-22021de968bd",
