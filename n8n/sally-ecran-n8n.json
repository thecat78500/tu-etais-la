    {
      "id": "7d45b17f-405b-4068-b509-6540bfb1f089",
      "name": "Ecran session",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        240,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "list",
          "value": "",
          "cachedResultName": "jeu_sessions"
        },
        "returnAll": true,
        "filters": {
          "conditions": [
            {
              "keyName": "session_id",
              "condition": "eq",
              "keyValue": "={{ typeof $json.body?.partie === \"string\" && /^M[A-Z0-9]{7}$/.test($json.body.partie.trim().toUpperCase()) ? $json.body.partie.trim().toUpperCase() : \"INVALIDE\" }}"
            }
          ]
        },
