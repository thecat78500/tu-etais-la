    {
      "id": "ee431a57-dd4a-54fb-8cd2-f437404852c3",
      "name": "Agent Sally - OpenAI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1840,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/responses",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ $json.request }}",
        "options": {
          "timeout": 90000,
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "7073e755-d07d-53a9-be1d-8b935a54137f",
      "name": "Valider la reponse de Sally",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2070,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const contexte = $('Preparer le contexte de Sally').first().json;\nlet reponse = contexte.fallback;\nlet origine = 'repli';\ntry {\n  const response = $input.first().json;\n  if (response.status !== 'completed') throw Error('Réponse IA non terminée');\n  const texte = (response.output || []).filter(o=>o.type==='message')\n    .flatMap(o=>o.content || []).filter(c=>c.type==='output_text').map(c=>c.text).join('');\n  const value = JSON.parse(texte);\n  if (typeof value.reply !== 'string' || !value.reply.trim() || value.reply.length>900) throw Error('Format inattendu');\n  reponse=value.reply.trim(); origine='ia';\n} catch {}\nreturn [{json:{session_id:contexte.session_id,telegram_chat_id:contexte.telegram_chat_id,\n  reponse,origine,telegram_html:reponse.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}}];\n"
      }
    },
    {
      "id": "30eb4cff-ec71-5739-8c10-75750e737e34",
      "name": "Repondre sur Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        2300,
