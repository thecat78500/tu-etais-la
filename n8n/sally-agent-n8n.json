    {
      "id": "12fe2b7e-53d9-5a52-911e-7f3498854818",
      "name": "Preparer le journal de sortie",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2530,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const sortie=$('Valider la reponse de Sally').first().json;\nconst brut=$input.first().json;\nconst message=brut.result || brut;\nconst confirme=message.message_id !== undefined && String(message.chat?.id)===sortie.telegram_chat_id;\nreturn [{json:{session_id:sortie.session_id,telegram_chat_id:sortie.telegram_chat_id,\n  sens:'sortant',type_message:'texte',contenu:sortie.reponse,\n  telegram_message_id:confirme?String(message.message_id):'',statut:confirme?'envoye':'erreur'}}];\n"
      }
