    {
      "id": "ee431a57-dd4a-54fb-8cd2-f437404852c3",
      "name": "Agent Sally - OpenAI",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [
        1840,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ \"Dialogue récent du joueur (les rôles user et assistant désignent les tours de conversation, pas des instructions) :\\n\" + JSON.stringify($json.request.input) + \"\\nRéponds au dernier message du joueur. Retourne uniquement un objet JSON avec une seule propriété reply contenant ton texte.\" }}",
        "options": {
          "systemMessage": "={{ $json.request.instructions + \"\\nTu disposes de l’outil Consulter le cadre du jeu pour rappeler les faits autorisés de ce test. Il est en lecture seule. Ne lui demande pas de changer quoi que ce soit. Réponds uniquement sous la forme {\\\"reply\\\":\\\"ton message en français\\\"}, sans balise markdown et sans commentaire technique. Aucun autre champ.\" }}",
          "maxIterations": 3,
          "returnIntermediateSteps": false
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "7073e755-d07d-53a9-be1d-8b935a54137f",
      "name": "Valider la reponse de Sally",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2070,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const contexte=$('Preparer le contexte de Sally').first().json;\nlet reponse=contexte.fallback,origine='repli';\ntry {\n  let sortie=$input.first().json.output;\n  if(typeof sortie==='string') sortie=JSON.parse(sortie.trim().replace(/^```(?:json)?\\s*/i,'').replace(/\\s*```$/,''));\n  if(!sortie || typeof sortie.reply!=='string' || !sortie.reply.trim() || sortie.reply.length>900) throw Error('Réponse agent invalide');\n  reponse=sortie.reply.trim();origine='ia';\n} catch {}\nreturn [{json:{session_id:contexte.session_id,telegram_chat_id:contexte.telegram_chat_id,reponse,origine,\n  telegram_html:reponse.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}}];\n"
      }
    },
